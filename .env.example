# Supabase project URL and publishable (anon) key.
# The publishable key is safe for the browser only when Row Level Security is on.
# Never put a service-role key or database password in a VITE_ or NEXT_PUBLIC_ variable.
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR-PUBLISHABLE-KEY"

# Vercel/Next-style aliases are also read by this build:
# NEXT_PUBLIC_SUPABASE_URL
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
